{
  "pluginAlias": "LightFusion",
  "pluginType": "platform",
  "singular": true,
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "default": "LightFusion",
        "required": true
      },
      "hueBridgeIp": {
        "title": "Hue Bridge IP",
        "type": "string",
        "placeholder": "192.168.68.80",
        "required": true
      },
      "hueApplicationKey": {
        "title": "Hue Application Key",
        "type": "string",
        "required": true
      },
      "hueLightIds": {
        "title": "Hue Light IDs",
        "type": "array",
        "items": {
          "type": "string"
        },
        "required": true
      },
      "goveeIp": {
        "title": "Govee H60A1 IP",
        "type": "string",
        "placeholder": "192.168.68.xxx",
        "required": true
      },
      "goveeLightId": {
        "title": "Govee Light ID",
        "type": "string",
        "default": "livingroom-big-light",
        "required": true
      },
      "goveeHueOffset": {
        "title": "Govee Hue Offset",
        "type": "number",
        "default": 0
      },
      "goveeSaturationScale": {
        "title": "Govee Saturation Scale",
        "type": "number",
        "default": 1
      },
      "goveeBrightnessScale": {
        "title": "Govee Brightness Scale",
        "type": "number",
        "default": 1
      },
      "goveeColorTemperatureOffset": {
        "title": "Govee Color Temperature Offset",
        "type": "number",
        "default": 0
      }
    }
  }
}