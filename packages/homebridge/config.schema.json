{
  "pluginAlias": "LightFusion",
  "pluginType": "platform",
  "singular": true,
  "customUi": true,
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "default": "LightFusion",
        "required": true
      },
      "hueBridgeIp": {
        "title": "Hue Bridge IP",
        "type": "string",
        "placeholder": "192.168.1.100"
      },
      "hueApplicationKey": {
        "title": "Hue Application Key",
        "type": "string"
      },
      "goveeApiKey": {
        "title": "Govee API Key",
        "type": "string"
      },
      "groups": {
        "title": "Light Groups",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "title": "Group ID",
              "type": "string",
              "required": true
            },
            "name": {
              "title": "HomeKit Name",
              "type": "string",
              "required": true
            },
            "referenceDevice": {
              "title": "Reference Device",
              "type": "object",
              "properties": {
                "providerId": {
                  "type": "string"
                },
                "lightId": {
                  "type": "string"
                }
              }
            },
            "members": {
              "title": "Group Members",
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "providerId": {
                    "type": "string"
                  },
                  "lightId": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "model": {
                    "type": "string"
                  },
                  "ip": {
                    "type": "string"
                  },
                  "calibration": {
                    "title": "Device Calibration",
                    "type": "object",
                    "properties": {
                      "profile": {
                        "type": "string"
                      },
                      "hueOffset": {
                        "type": "number"
                      },
                      "saturationScale": {
                        "type": "number"
                      },
                      "brightnessScale": {
                        "type": "number"
                      },
                      "brightnessMap": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "input": {
                              "type": "number"
                            },
                            "output": {
                              "type": "number"
                            }
                          }
                        }
                      },
                      "colorTemperatureOffset": {
                        "type": "number"
                      }
                    }
                  }
                }
              }
            },
            "hueLightIds": {
              "title": "Legacy Hue Light IDs",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "govee": {
              "title": "Legacy Govee Light",
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "model": {
                  "type": "string"
                },
                "ip": {
                  "type": "string"
                },
                "calibrationProfile": {
                  "type": "string"
                },
                "hueOffset": {
                  "type": "number"
                },
                "saturationScale": {
                  "type": "number"
                },
                "brightnessScale": {
                  "type": "number"
                },
                "colorTemperatureOffset": {
                  "type": "number"
                }
              }
            }
          }
        }
      }
    }
  }
}
