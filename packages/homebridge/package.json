{
  "name": "homebridge-lightfusion",
  "displayName": "LightFusion",
  "version": "0.0.0",
  "private": true,
  "description": "Homebridge interface for synchronized and calibrated mixed-brand lighting",
  "author": "drubular",
  "license": "MIT",
  "homepage": "https://github.com/drubular/homebridge-lightfusion#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/drubular/homebridge-lightfusion.git"
  },
  "bugs": {
    "url": "https://github.com/drubular/homebridge-lightfusion/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "config.schema.json"
  ],
  "keywords": [
    "homebridge-plugin",
    "supports-hap",
    "homebridge",
    "homekit",
    "lighting",
    "philips-hue",
    "govee"
  ],
  "engines": {
    "node": "^22.10.0 || ^24.0.0",
    "homebridge": "^1.8.0 || ^2.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@lightfusion/core": "0.0.0"
  },
  "devDependencies": {
    "homebridge": "^2.3.0"
  }
}
